{
  "mcpServers": {
    "meta-ads-remote": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://your-deployment.vercel.app/api/mcp",
        "--header",
        "Authorization:${META_AUTH_HEADER}"
      ],
      "env": {
        "META_AUTH_HEADER": "Bearer <paste the session token from your dashboard>"
      }
    }
  }
}
