# ---------------------------------------------------------------------------
# Meta OAuth (required for the hosted web app)
# ---------------------------------------------------------------------------
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ---------------------------------------------------------------------------
# Session signing (required) - the server refuses to start without it.
# Generate with: openssl rand -base64 48
# Must be at least 32 characters. Rotating this invalidates every session
# and (unless TOKEN_ENCRYPTION_KEY is set) every stored Meta token.
# ---------------------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------------------
# Access PIN (recommended) - locks the whole web app behind a shared PIN.
# Set ACCESS_PIN, or ACCESS_PIN_HASH to keep the PIN itself out of the
# environment: printf '1234' | shasum -a 256
# With neither set the site is open to anyone who knows the URL.
# ---------------------------------------------------------------------------
ACCESS_PIN=
# ACCESS_PIN_HASH=

# ---------------------------------------------------------------------------
# Token encryption at rest (optional)
# 32 bytes, hex or base64: openssl rand -base64 32
# When unset, the key is derived from JWT_SECRET.
# ---------------------------------------------------------------------------
# TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Storage - set exactly one. Redis takes precedence when both are present.
# ---------------------------------------------------------------------------
REDIS_URL=redis://default:password@host:port
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---------------------------------------------------------------------------
# Optional Meta API configuration
# ---------------------------------------------------------------------------
META_API_VERSION=v23.0
META_BASE_URL=https://graph.facebook.com

# ---------------------------------------------------------------------------
# Local stdio server only (not used by the hosted web app)
# ---------------------------------------------------------------------------
# META_ACCESS_TOKEN=
# META_AUTO_REFRESH=true
MCP_SERVER_NAME=Meta Marketing API Server (Dev)
NODE_ENV=development
